PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=12h
# Postgres. Leave DATABASE_URL blank and the API runs PGlite — Postgres
# compiled to WebAssembly, in process — out of PG_DATA_DIR, so there is
# nothing to install locally. Set it in production.
DATABASE_URL=
PG_DATA_DIR=./data/pg
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
CURRENCY=UGX
SHOP_NAME=Al Hadeed Hardware
OTP_DEV_MODE=true

# ── SMS gateway (login codes) ───────────────────────────────────────────
# log            write the code to the server console, send nothing (default)
# africastalking Africa's Talking — the usual choice in Uganda
# generic        any gateway that takes a JSON POST; set SMS_URL
SMS_PROVIDER=log
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=
SMS_URL=

# Set OTP_DEV_MODE=false with a real SMS_PROVIDER to send real random codes.
